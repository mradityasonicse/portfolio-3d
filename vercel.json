{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server/index.js"
    }
  ],
  "buildCommand": "npm install && cd admin && npm install && npm run build",
  "outputDirectory": ".",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  }
}
