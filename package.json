{
  "name": "premium-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:admin\"",
    "dev:server": "node server/index.js",
    "dev:admin": "cd admin && npm run dev",
    "build:admin": "cd admin && npm run build",
    "start": "node server/index.js",
    "install:all": "npm install && cd admin && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "rate-limiter-flexible": "^5.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9"
  }
}
